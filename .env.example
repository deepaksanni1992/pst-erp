# ===== PST ERP frontend (repo root — Vite reads env from here) =====
# Copy to .env for local overrides. Never commit real secrets.

# Production build: backend origin without /api (set on Vercel/Render).
# VITE_API_BASE_URL=your_backend_origin
# VITE_API_BASE=your_backend_origin

# Only if local UI must call a remote API instead of the Vite proxy:
# VITE_USE_REMOTE_API_WHILE_LOCAL=true

# Document uploads use POST /api/documents — AWS keys belong only in backend/.env (never in the frontend).
