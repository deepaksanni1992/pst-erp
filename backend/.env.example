# ===== PST ERP backend environment =====

# MongoDB — use a separate database name for PST so data is isolated from any other ERP.
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>/pst_erp?retryWrites=true&w=majority
# Local example:  mongodb://127.0.0.1:27017/pst_erp
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/pst_erp?retryWrites=true&w=majority

# JWT signing secret — generate a strong random string for production.
JWT_SECRET=replace-with-strong-secret

# Server port (frontend Vite dev defaults to 5174; proxy forwards /api → 5001)
PORT=5001

# CORS — deployed frontend origin (optional extra). Defaults in server.js include localhost and https://pst-erp-frontend.onrender.com
CLIENT_URL=http://localhost:5174

NODE_ENV=development

# AWS S3 — Document Management (set on Render; never expose to frontend)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pst-erp-documents

# Tenant-scoped key prefix. Every uploaded object is namespaced under
# ${AWS_S3_KEY_PREFIX}<folder>/<yyyy>/<mm>/<file>. Default "pst-erp/".
# Set to a different prefix if you ever share the bucket with another ERP.
AWS_S3_KEY_PREFIX=pst-erp/

# Optional: signed-URL TTL in seconds (default 300)
AWS_S3_SIGNED_URL_TTL_SECONDS=300

# Optional: payment slip folder (default "payment-slips")
AWS_S3_PAYMENT_SLIP_FOLDER=payment-slips
