# ===== PST ERP frontend (optional folder) =====
# The Vite app lives at the repo root; copy root `.env.example` or set these in your host (e.g. Render/Vercel).

# Production API origin — no /api suffix (e.g. https://pst-erp-backend.onrender.com)
VITE_API_BASE_URL=your_backend_origin

# Alternative name supported by src/lib/api.js:
# VITE_API_BASE=your_backend_origin

# Only if local UI must call a remote API instead of Vite proxy:
# VITE_USE_REMOTE_API_WHILE_LOCAL=true
